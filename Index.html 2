
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#10101b">
<title>Brayan AI</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #10101b;
  color: white;
  font-family: Arial, sans-serif;
  height: 100dvh;
  display: flex;
  flex-direction: column;
}

header {
  padding: 18px;
  background: #171727;
  border-bottom: 1px solid #292940;
  display: flex;
  align-items: center;
  gap: 12px;
}

.logo {
  width: 42px;
  height: 42px;
  background: linear-gradient(135deg,#8b5cf6,#4931c9);
  border-radius: 14px;
  display: grid;
  place-items: center;
  font-size: 23px;
  font-weight: bold;
}

header h2 {
  margin: 0;
  font-size: 19px;
}

.status {
  color: #43dc91;
  font-size: 12px;
  margin-top: 5px;
}

#chat {
  flex: 1;
  overflow-y: auto;
  padding: 18px 14px;
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.welcome {
  text-align: center;
  margin: auto 0;
  color: #aaaac0;
}

.welcome h1 {
  color: white;
  font-size: 27px;
}

.message {
  max-width: 88%;
  padding: 13px 15px;
  border-radius: 16px;
  line-height: 1.5;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.user {
  align-self: flex-end;
  background: #7048df;
  border-bottom-right-radius: 4px;
}

.bot {
  align-self: flex-start;
  background: #222237;
  border-bottom-left-radius: 4px;
}

#form {
  padding: 12px;
  background: #171727;
  display: flex;
  gap: 9px;
  border-top: 1px solid #292940;
}

#input {
  flex: 1;
  min-width: 0;
  background: #25253b;
  color: white;
  border: 1px solid #393951;
  border-radius: 14px;
  padding: 14px;
  font-size: 16px;
  outline: none;
}

#send {
  width: 50px;
  border: none;
  border-radius: 14px;
  color: white;
  background: #8055ef;
  font-size: 22px;
}

#send:disabled {
  opacity: .5;
}

footer {
  text-align: center;
  padding: 7px;
  background: #171727;
  color: #77778c;
  font-size: 11px;
}
</style>
</head>

<body>

<header>
  <div class="logo">B</div>
  <div>
    <h2>Brayan AI</h2>
    <div class="status">● Assistente online</div>
  </div>
</header>

<main id="chat">
  <div class="welcome" id="welcome">
    <h1>Olá! 👋</h1>
    <p>Eu sou a Brayan AI.</p>
    <p>O que vamos conversar hoje?</p>
  </div>
</main>

<form id="form">
  <input
    id="input"
    type="text"
    placeholder="Pergunte alguma coisa..."
    autocomplete="off"
    required
  >
  <button id="send" type="submit">➤</button>
</form>

<footer>Brayan AI • Inteligência Artificial</footer>

<script>
const chat = document.getElementById("chat");
const form = document.getElementById("form");
const input = document.getElementById("input");
const send = document.getElementById("send");
const welcome = document.getElementById("welcome");

let messages = [];

function addMessage(text, type) {
  if (welcome) welcome.remove();

  const div = document.createElement("div");
  div.className = "message " + type;
  div.textContent = text;

  chat.appendChild(div);
  chat.scrollTop = chat.scrollHeight;
  return div;
}

form.addEventListener("submit", async function(event) {
  event.preventDefault();

  const text = input.value.trim();
  if (!text || send.disabled) return;

  input.value = "";
  addMessage(text, "user");

  messages.push({
    role: "user",
    content: text
  });

  send.disabled = true;
  const loading = addMessage("Pensando...", "bot");

  try {
    const response = await fetch("/api/chat", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        messages: messages
      })
    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(data.error || "Erro no servidor.");
    }

    if (!data.reply) {
      throw new Error("A IA não retornou uma resposta.");
    }

    loading.textContent = data.reply;

    messages.push({
      role: "assistant",
      content: data.reply
    });

  } catch (error) {
    loading.textContent = "Não consegui conectar à IA. " + error.message;
    messages.pop();
  }

  send.disabled = false;
  input.focus();
  chat.scrollTop = chat.scrollHeight;
});
</script>

</body>
</html>
